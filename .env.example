# === API ===
ANTHROPIC_API_KEY=sk-ant-...

# === Flask / Web-UI ===
FLASK_SECRET_KEY=           # openssl rand -hex 32
ADMIN_PASSWORD=             # Initiales Admin-Passwort (leer = "admin")

# === Budget-Limits ===
DAILY_BUDGET_EUR=10.00
MONTHLY_BUDGET_EUR=100.00

# === E-Mail-Eingang & Ausgang ===
# Für Gmail: App-Passwort unter myaccount.google.com → Sicherheit → App-Passwörter
# Plus-Addressing: belege+mandantid@gmail.com → automatisches Routing
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_USER=belege@gmail.com        # Deine Gmail-Adresse
IMAP_PASSWORD=                    # App-Passwort (16 Zeichen)

# === IMAP-Poll (kostenlos, kein Drittanbieter nötig) ===
# Mandanten senden Belege an: belege+MANDANT_ID@gmail.com
# Der Agent holt neue E-Mails per IMAP ab — manuell über Dashboard-Button oder automatisch.
# Gmail: App-Passwort unter myaccount.google.com → Sicherheit → 2FA → App-Passwörter
# IMAP_USER und IMAP_PASSWORD sind oben bereits konfiguriert (gleiche Zugangsdaten).
IMAP_POLL_INTERVAL=0              # Minuten zwischen automatischen Hintergrund-Polls (0 = nur manuell)

# === Report-E-Mail ===
# Wohin soll der Tages-Report nach jedem Pipeline-Run geschickt werden?
REPORT_EMAIL_TO=steuerberater@kanzlei.de
# Öffentliche URL des Agents (für Links in der Report-E-Mail)
PUBLIC_URL=https://dein-ngrok-link.ngrok-free.app

# === Verzeichnisse ===
INBOX_WATCH_DIR=./inbox

# === DATEV-Defaults ===
DATEV_BERATER_NR=
DATEV_MANDANT_NR=
KONTENRAHMEN=SKR03

# === Pipeline ===
KONFIDENZ_SCHWELLE=0.7

# === Auto-Scheduler ===
# Pipeline täglich automatisch starten (kein manueller Klick nötig)
PIPELINE_SCHEDULE_ACTIVE=false    # auf "true" setzen zum Aktivieren
PIPELINE_SCHEDULE_TIME=18:00      # Uhrzeit (Europe/Berlin)

# === Ngrok Tunnel ===
NGROK_AUTHTOKEN=
FLASK_PORT=5001

# === Datenbank (Docker) ===
# DB_PATH=/app/data/fibu_agent.db

# === Verschlüsselung (DSGVO Art. 32) ===
# Wird beim ersten Start automatisch generiert und in .env eingetragen
# ENCRYPTION_KEY=           # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# === Alert-E-Mails (Monitoring) ===
ALERT_EMAIL=                # Bei Budget-Überschreitung / Systemfehler
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# === Vapi Voice-Agent (optional) ===
VAPI_SECRET=                # Geheimnis für X-Vapi-Secret Header
