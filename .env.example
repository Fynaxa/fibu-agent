# === API ===
ANTHROPIC_API_KEY=sk-ant-...

# === Flask / Web-UI ===
FLASK_SECRET_KEY=           # openssl rand -hex 32
ADMIN_PASSWORD=             # Initiales Admin-Passwort. Pflicht: leer erzeugt beim ersten Start den Nutzer admin/admin

# === Budget-Limits ===
DAILY_BUDGET_EUR=10.00
MONTHLY_BUDGET_EUR=100.00

# === E-Mail-Eingang & Ausgang ===
# Für Gmail: App-Passwort unter myaccount.google.com → Sicherheit → App-Passwörter
# Plus-Addressing: belege+mandantid@ihre-domain.de → automatisches Routing
IMAP_HOST=imap.ihr-anbieter.de
SMTP_HOST=smtp.ihr-anbieter.de
SMTP_PORT=587
IMAP_USER=belege@ihre-domain.de   # Postfach, das Belege empfaengt
IMAP_PASSWORD=                    # App-Passwort (16 Zeichen)

# === IMAP-Poll ===
# Mandanten senden Belege an: belege+MANDANT_ID@ihre-domain.de
# Der Agent holt neue E-Mails per IMAP ab, manuell über den Dashboard-Knopf oder
# über den Auto-Scheduler unten. IMAP_USER und IMAP_PASSWORD gelten auch hier.

# === Report-E-Mail ===
# Wohin soll der Tages-Report nach jedem Pipeline-Run geschickt werden?
REPORT_EMAIL_TO=steuerberater@kanzlei.de
# Öffentliche URL des Agents (für Links in der Report-E-Mail)
PUBLIC_URL=https://fibu.ihre-domain.de

# === Verzeichnisse ===
INBOX_WATCH_DIR=./inbox

# === DATEV-Defaults ===
DATEV_BERATER_NR=
DATEV_MANDANT_NR=
KONTENRAHMEN=SKR03

# === Pipeline ===
KONFIDENZ_SCHWELLE=0.7

# === Auto-Scheduler ===
# Pipeline täglich automatisch starten (kein manueller Klick nötig)
PIPELINE_SCHEDULE_ACTIVE=false    # auf "true" setzen zum Aktivieren
PIPELINE_SCHEDULE_TIME=18:00      # Uhrzeit (Europe/Berlin)

# === Ngrok Tunnel ===
NGROK_AUTHTOKEN=
FLASK_PORT=5001

# === Datenbank (Docker) ===
# DB_PATH=/app/data/fibu_agent.db

# === Verschlüsselung (DSGVO Art. 32) ===
# Wird beim ersten Start automatisch generiert und in .env eingetragen
# ENCRYPTION_KEY=           # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# === Alert-E-Mails (Monitoring) ===
ALERT_EMAIL=                # Bei Budget-Überschreitung / Systemfehler
ALERT_SMTP_HOST=smtp.ihr-anbieter.de
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# === Mailgun (optional, Beleg-Eingang per Webhook statt IMAP) ===
# Nur noetig, wenn Mails ueber Mailgun eingehen. Die Signatur jeder Zustellung
# wird gegen den Signing Key geprueft. Ohne Key lehnt der Webhook jede Anfrage
# ab (503), damit niemand ueber die bekannte Adresse Belege einschleusen kann.
MAILGUN_DOMAIN=
MAILGUN_SIGNING_KEY=
