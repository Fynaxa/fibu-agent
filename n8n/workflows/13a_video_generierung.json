{
  "name": "13a — Video-Generierung (ElevenLabs + HeyGen)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-generieren",
        "options": {}
      },
      "id": "webhook-video",
      "name": "Video-Auftrag (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-6",
        "prompt": "Du bist Video-Skript-Autor für eine KI-Automatisierungsagentur.\n\nErstelle ein Skript für ein {{ $json.body.plattform }}-Video.\n\nThema: {{ $json.body.thema }}\nTyp: {{ $json.body.typ }}\nZiel-Länge: {{ $json.body.plattform === 'tiktok' ? '30-60 Sekunden' : '3-5 Minuten' }}\n\nAnforderungen:\n- Hook in den ersten 3 Sekunden (Frage oder provokante These)\n- Klare Struktur: Hook → Problem → Lösung → CTA\n- Sprache: Deutsch, professionell aber nahbar\n- Für einen KI-Avatar — keine physischen Aktionen\n- Jeder Absatz = eine Szene mit eigenem Hintergrundbild\n- Natürlicher Sprachfluss — so wie ein Mensch frei spricht, keine Schriftsprache\n- Kurze Sätze, Pausen durch Absätze\n\nAntworte als JSON:\n{\n  \"titel\": \"<Video-Titel, SEO-optimiert, max 60 Zeichen>\",\n  \"beschreibung\": \"<200 Wörter YouTube-Beschreibung mit Keywords>\",\n  \"skript\": [\n    {\n      \"szene\": 1,\n      \"text\": \"<gesprochener Text für diese Szene>\",\n      \"dauer_sek\": 5,\n      \"hintergrund\": \"<Beschreibung: z.B. Büro, Dashboard-Screenshot, Diagramm>\"\n    }\n  ],\n  \"thumbnail_text\": \"<3-5 Wörter für Thumbnail>\",\n  \"tags\": [\"tag1\", \"tag2\"]\n}",
        "options": { "maxTokens": 1500, "temperature": 0.7 }
      },
      "id": "claude-skript",
      "name": "1. Claude: Video-Skript schreiben",
      "type": "@n8n/n8n-nodes-langchain.anthropicChat",
      "typeVersion": 1,
      "position": [240, 0],
      "credentials": { "anthropicApi": { "id": "anthropic-cred", "name": "Anthropic" } }
    },
    {
      "parameters": {
        "jsCode": "const skript = $input.first().json;\nconst body = $('Video-Auftrag (Webhook)').first().json.body;\n\n// Szenen-Texte für ElevenLabs aufbereiten\n// Pro Szene ein eigener Audio-Request (besser für Lippensync)\nconst szenen = skript.skript.map((s, i) => ({\n  szene: s.szene || i + 1,\n  text: s.text,\n  dauer_sek: s.dauer_sek || 5,\n  hintergrund: s.hintergrund || '#f5f7fa'\n}));\n\n// Gesamttext für einzelne Audio-Datei\nconst volltext = szenen.map(s => s.text).join(' ... ');\n\nreturn [{\n  json: {\n    ...skript,\n    plattform: body.plattform,\n    szenen,\n    volltext,\n    ist_short: body.plattform === 'tiktok' || body.plattform === 'instagram'\n  }\n}];"
      },
      "id": "code-prepare",
      "name": "Skript aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "url": "https://api.elevenlabs.io/v1/text-to-speech/{{ $env.ELEVENLABS_VOICE_ID }}",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xi-api-key", "value": "={{ $env.ELEVENLABS_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "audio/mpeg" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.volltext, model_id: 'eleven_multilingual_v2', voice_settings: { stability: 0.5, similarity_boost: 0.8, style: 0.3, use_speaker_boost: true }, language_code: 'de' }) }}",
        "options": {
          "response": { "response": { "responseFormat": "file" } },
          "timeout": 60000
        }
      },
      "id": "http-elevenlabs-tts",
      "name": "2. ElevenLabs: Stimme generieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "url": "https://api.elevenlabs.io/v1/audio-isolation",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xi-api-key", "value": "={{ $env.ELEVENLABS_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "audio", "parameterType": "formBinaryData", "inputDataFieldName": "data" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "file" } },
          "timeout": 30000
        }
      },
      "id": "http-elevenlabs-cleanup",
      "name": "2b. Audio aufbereiten (optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Audio-Daten aus ElevenLabs sind als Binary in $binary\nconst meta = $('Skript aufbereiten').first().json;\n\n// Audio-URL vorbereiten — HeyGen braucht eine URL zum Audio\n// Option 1: Direkt als Base64 mitgeben\n// Option 2: Vorher auf einen temporären Storage hochladen\n\n// Wir nutzen HeyGen's audio_url Feature\n// Zuerst Audio temporär hosten (n8n webhook als proxy)\nconst audioBase64 = $input.first().binary?.data?.data || '';\n\nreturn [{\n  json: {\n    ...meta,\n    audio_available: true,\n    audio_base64: audioBase64\n  },\n  binary: $input.first().binary\n}];"
      },
      "id": "code-audio-ready",
      "name": "Audio bereit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "url": "https://api.heygen.com/v2/video/generate",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "={{ $env.HEYGEN_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_inputs: $json.szenen.map(s => ({ character: { type: 'avatar', avatar_id: $env.HEYGEN_AVATAR_ID, avatar_style: 'normal' }, voice: { type: 'audio', audio_url: $env.ELEVENLABS_AUDIO_PROXY_URL || '', input_text: s.text, voice_id: $env.ELEVENLABS_VOICE_ID_HEYGEN || $env.HEYGEN_ELEVENLABS_VOICE_ID }, background: { type: 'color', value: '#ffffff' } })), dimension: { width: $json.ist_short ? 1080 : 1920, height: $json.ist_short ? 1920 : 1080 }, title: $json.titel, callback_url: ($env.WEBHOOK_URL || 'http://n8n:5678') + '/webhook/video-fertig' }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "http-heygen-elevenlabs",
      "name": "3. HeyGen: Video mit ElevenLabs-Stimme",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "https://api.heygen.com/v2/video/generate",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "={{ $env.HEYGEN_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_inputs: $json.szenen.map(s => ({ character: { type: 'avatar', avatar_id: $env.HEYGEN_AVATAR_ID, avatar_style: 'normal' }, voice: { type: 'elevenlabs', voice_id: $env.ELEVENLABS_VOICE_ID, input_text: s.text, language: 'de' }, background: { type: 'color', value: '#ffffff' } })), dimension: { width: $json.ist_short ? 1080 : 1920, height: $json.ist_short ? 1920 : 1080 }, title: $json.titel }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "http-heygen-native-el",
      "name": "3-ALT. HeyGen native ElevenLabs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst videoId = result.data?.video_id || result.video_id;\nconst meta = $('Skript aufbereiten').first().json;\n\nreturn [{\n  json: {\n    video_id: videoId,\n    status: 'processing',\n    titel: meta.titel,\n    beschreibung: meta.beschreibung,\n    tags: meta.tags,\n    plattform: meta.plattform,\n    thumbnail_text: meta.thumbnail_text,\n    ist_short: meta.ist_short\n  }\n}];"
      },
      "id": "code-video-id",
      "name": "Video-ID extrahieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 0]
    },
    {
      "parameters": {
        "amount": 120,
        "unit": "seconds"
      },
      "id": "wait-render",
      "name": "2 Min warten (Rendering)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1680, 0]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.heygen.com/v1/video_status.get?video_id=' + $('Video-ID extrahieren').first().json.video_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "={{ $env.HEYGEN_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "http-check-status",
      "name": "4. Video-Status prüfen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 0]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst meta = $('Video-ID extrahieren').first().json;\n\nconst videoUrl = result.data?.video_url || result.video_url;\nconst status = result.data?.status || result.status;\nconst ready = status === 'completed';\n\nreturn [{\n  json: {\n    ready,\n    video_url: videoUrl,\n    status,\n    titel: meta.titel,\n    beschreibung: meta.beschreibung,\n    tags: meta.tags,\n    plattform: meta.plattform,\n    thumbnail_text: meta.thumbnail_text,\n    ist_short: meta.ist_short\n  }\n}];"
      },
      "id": "code-result",
      "name": "Ergebnis auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2160, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.ready }}", "value2": true }]
        }
      },
      "id": "if-ready",
      "name": "Video fertig?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2400, 0]
    },
    {
      "parameters": {
        "amount": 180,
        "unit": "seconds"
      },
      "id": "wait-retry",
      "name": "3 Min warten + Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2400, 200]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            { "outputKey": "youtube", "conditions": { "string": [{ "value1": "={{ $json.plattform }}", "value2": "youtube" }] } },
            { "outputKey": "tiktok", "conditions": { "string": [{ "value1": "={{ $json.plattform }}", "value2": "tiktok" }] } },
            { "outputKey": "instagram" }
          ]
        }
      },
      "id": "switch-upload",
      "name": "5. Upload-Ziel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [2640, -100]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.YOUTUBE_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ snippet: { title: $json.titel, description: $json.beschreibung + '\\n\\n#KI #Automatisierung #Buchhaltung #DATEV #Steuerberater', tags: $json.tags, categoryId: '28', defaultLanguage: 'de' }, status: { privacyStatus: 'public', selfDeclaredMadeForKids: false } }) }}",
        "options": {}
      },
      "id": "http-youtube",
      "name": "YouTube hochladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, -250],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.TIKTOK_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_info: { title: $json.titel.substring(0, 150), privacy_level: 'PUBLIC_TO_EVERYONE', disable_duet: false, disable_comment: false, disable_stitch: false, video_cover_timestamp_ms: 1000 }, source_info: { source: 'PULL_FROM_URL', video_url: $json.video_url } }) }}",
        "options": {}
      },
      "id": "http-tiktok",
      "name": "TikTok hochladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, -100],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{ 'https://graph.facebook.com/v19.0/' + $env.INSTAGRAM_BUSINESS_ID + '/media' }}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "media_type", "value": "REELS" },
            { "name": "video_url", "value": "={{ $json.video_url }}" },
            { "name": "caption", "value": "={{ $json.titel + '\\n\\n' + $json.beschreibung.substring(0, 200) + '\\n\\n#KI #Automatisierung #Buchhaltung #DATEV #Steuerberater #Digitalisierung' }}" },
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "http-instagram-reel",
      "name": "Instagram Reel hochladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, 50],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": { "mode": "list", "value": "={{ $env.GSHEET_CRM_ID }}" },
        "sheetName": "Content-Log",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "datum": "={{ $now.format('yyyy-MM-dd') }}",
            "plattform": "={{ $json.plattform }}",
            "status": "video_gepostet",
            "typ": "video",
            "thema": "={{ $json.titel }}",
            "video_url": "={{ $json.video_url }}",
            "pipeline": "elevenlabs+heygen"
          }
        }
      },
      "id": "sheets-log",
      "name": "6. Content-Log aktualisieren",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [3120, -100],
      "credentials": { "googleSheetsOAuth2Api": { "id": "google-cred", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $env.ADMIN_EMAIL }}",
        "subject": "={{ '🎬 Video veröffentlicht: ' + $json.titel + ' (' + $json.plattform + ')' }}",
        "text": "={{ 'Neues Video automatisch veröffentlicht:\\n\\nTitel: ' + $json.titel + '\\nPlattform: ' + $json.plattform + '\\nVideo-URL: ' + $json.video_url + '\\n\\nPipeline: Claude (Skript) → ElevenLabs (Stimme) → HeyGen (Video) → ' + $json.plattform + ' (Upload)' }}",
        "options": {}
      },
      "id": "smtp-bestaetigung",
      "name": "Bestätigung per E-Mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [3120, 100],
      "credentials": { "smtp": { "id": "smtp-cred", "name": "SMTP" } }
    }
  ],
  "connections": {
    "Video-Auftrag (Webhook)": { "main": [[{ "node": "1. Claude: Video-Skript schreiben", "type": "main", "index": 0 }]] },
    "1. Claude: Video-Skript schreiben": { "main": [[{ "node": "Skript aufbereiten", "type": "main", "index": 0 }]] },
    "Skript aufbereiten": { "main": [[{ "node": "2. ElevenLabs: Stimme generieren", "type": "main", "index": 0 }]] },
    "2. ElevenLabs: Stimme generieren": { "main": [[{ "node": "Audio bereit", "type": "main", "index": 0 }]] },
    "Audio bereit": { "main": [[{ "node": "3. HeyGen: Video mit ElevenLabs-Stimme", "type": "main", "index": 0 }]] },
    "3. HeyGen: Video mit ElevenLabs-Stimme": { "main": [[{ "node": "Video-ID extrahieren", "type": "main", "index": 0 }]] },
    "Video-ID extrahieren": { "main": [[{ "node": "2 Min warten (Rendering)", "type": "main", "index": 0 }]] },
    "2 Min warten (Rendering)": { "main": [[{ "node": "4. Video-Status prüfen", "type": "main", "index": 0 }]] },
    "4. Video-Status prüfen": { "main": [[{ "node": "Ergebnis auswerten", "type": "main", "index": 0 }]] },
    "Ergebnis auswerten": { "main": [[{ "node": "Video fertig?", "type": "main", "index": 0 }]] },
    "Video fertig?": {
      "main": [
        [{ "node": "5. Upload-Ziel", "type": "main", "index": 0 }],
        [{ "node": "3 Min warten + Retry", "type": "main", "index": 0 }]
      ]
    },
    "3 Min warten + Retry": { "main": [[{ "node": "4. Video-Status prüfen", "type": "main", "index": 0 }]] },
    "5. Upload-Ziel": {
      "main": [
        [{ "node": "YouTube hochladen", "type": "main", "index": 0 }],
        [{ "node": "TikTok hochladen", "type": "main", "index": 0 }],
        [{ "node": "Instagram Reel hochladen", "type": "main", "index": 0 }]
      ]
    },
    "YouTube hochladen": { "main": [[{ "node": "6. Content-Log aktualisieren", "type": "main", "index": 0 }, { "node": "Bestätigung per E-Mail", "type": "main", "index": 0 }]] },
    "TikTok hochladen": { "main": [[{ "node": "6. Content-Log aktualisieren", "type": "main", "index": 0 }, { "node": "Bestätigung per E-Mail", "type": "main", "index": 0 }]] },
    "Instagram Reel hochladen": { "main": [[{ "node": "6. Content-Log aktualisieren", "type": "main", "index": 0 }, { "node": "Bestätigung per E-Mail", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": [{ "name": "Marketing" }, { "name": "Video" }]
}
